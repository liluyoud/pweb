# Matrícula do professor, diferente das matrículas dos alunos
PROFESSOR_MATRICULA=
# Data de nascimento no formato AAAA-MM-DD
PROFESSOR_DATA_NASCIMENTO=
# Chave gerada localmente com 32 bytes aleatórios em hexadecimal
APP_KEY=

# Para estudar em casa com docs/alunos.exemplo.md e o banco exemplo.sqlite,
# remova o # da linha seguinte. Somente o valor 1 ativa o modo de exemplo.
# CONTROLE_N2_DADOS_EXEMPLO=1

# Usadas na publicação (já definidas no docker-compose.yml da raiz; veja ../docs/dokploy.md):
# HOST=0.0.0.0                   endereço de escuta (padrão 127.0.0.1)
# PORT=3400                      porta do servidor
# NODE_ENV=production            entrega JS e CSS minificados
# CAMINHO_BASE=/n2               subcaminho público, usado pelo Scalar
# CONFIAR_PROXY=1                lê HTTPS e IP do visitante dos cabeçalhos do proxy
# CONTROLE_N2_BANCO=/dados/controle_n2.sqlite   caminho do banco
